# ============================================================================
# Orbit - configuration
# Copy to .env and change SESSION_SECRET + ADMIN_PASSWORD before any real use.
#   cp .env.example .env
#
# The values here are the ones this project actually runs on a 6-core / 6 GB
# machine over a LAN: 1080p at 45fps, quality 100, pinned viewport. They favour
# picture quality over bandwidth, which is the right trade on a local network and
# the wrong one over the Internet. Every line that costs something says so, and
# docs/performance.md has the measurements behind the numbers.
# ============================================================================

# ----------------------------------------------------------------------------
# THE WORKING .env, VERBATIM - copy this block, drop the leading "# ", use as is.
#
# This is what the deployment this project was built on actually runs: 6-core /
# 6 GB box, 1080p at 45fps over a LAN. Only the two secrets are placeholders;
# everything else is the real value and needs no thought.
#
# SESSION_SECRET=<openssl rand -hex 32>
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<choose your own>
# LOG_LEVEL=info
# VIEWPORT_WIDTH=1920
# VIEWPORT_HEIGHT=1080
# STREAM_QUALITY=100
# MAX_FPS=45
# MAX_VIEWPORT_WIDTH=2560
# MAX_VIEWPORT_HEIGHT=1440
# PIN_VIEWPORT=true
# MEMORY_LIMIT=6g
# CPU_LIMIT=6.0
# DEVICE_SCALE_FACTOR=1
# HOME_URL=https://www.google.com
# DEVTOOLS_ENABLED=true
# PERSIST_SESSION_COOKIES=true
#
# Anything not listed above keeps the default from the sections below.
# ----------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
APP_PORT=3030
SERVER_HOST=0.0.0.0
# Which host interface the published port binds to. 0.0.0.0 is every interface,
# which is what makes it reachable from other machines; pin it to one address
# (APP_BIND=192.168.1.100) to keep it off the others.
APP_BIND=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Signs session cookies. Any change invalidates all existing sessions.
# Generate one:  openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32
SESSION_TTL_HOURS=168

# --- Bootstrap admin (created on first start only) --------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Storage ---------------------------------------------------------------
# SQLite file for users/sessions/tabs/audit. Lives on the data volume.
DATABASE_URL=file:/data/app.db
# Chromium profile. Persists cookies, localStorage, IndexedDB, history.
CHROMIUM_DATA_DIR=/data/profile
DOWNLOAD_DIR=/data/downloads
UPLOAD_DIR=/data/uploads
# Unpacked Chromium extensions, one directory each. Admins can upload a .zip
# through the admin panel; applying a change needs a browser restart.
EXTENSIONS_DIR=/data/extensions
EXTENSIONS_ENABLED=true

# --- Chromium --------------------------------------------------------------
# Page new tabs open on, and what the browser starts on. Recommended: a real
# home page, so a new tab is useful immediately. Use about:blank instead if the
# deployment has to work with no Internet at all.
HOME_URL=https://www.google.com

CHROMIUM_PATH=
# false runs a real headed browser on a virtual display (Xvfb in the container).
# That is what websites expect; headless is a configuration bot-detection flags.
# Costs roughly 40% more CPU and twice the memory - see docs/performance.md.
# Outside Docker, false opens real windows on your desktop.
CHROMIUM_HEADLESS=false
# CDP port. Bound to 127.0.0.1 inside the container and never published.
CDP_PORT=9222
# Chromium's own sandbox needs SYS_ADMIN in a container; see docs/security.md.
CHROMIUM_SANDBOX=false
CHROMIUM_LOCALE=en-US
CHROMIUM_TIMEZONE=UTC

# --- Streaming -------------------------------------------------------------
# Recommended 1920x1080: text stays crisp on a HiDPI screen, and the frame is
# scaled down to fit smaller ones. 1280x720 roughly halves the CPU and bandwidth
# if you are running on fewer than 4 cores.
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
# true = always stream VIEWPORT_WIDTH x VIEWPORT_HEIGHT and ignore the size each
# client asks for. Set this when your screen is smaller than the resolution you
# want to browse at - the frame is scaled to fit, so you see more of the page and
# it looks sharper on a HiDPI display. Small clients still pay full bandwidth.
PIN_VIEWPORT=true
MAX_VIEWPORT_WIDTH=2560
MAX_VIEWPORT_HEIGHT=1440
# 45 is smooth for scrolling and video; 30 is fine for reading and costs a third
# less CPU. The cap that matters is tab count, not fps - twenty animating tabs
# saturate six cores (docs/performance.md#stress-and-abuse).
MAX_FPS=45
# JPEG quality 1-100. 100 on a LAN, where bandwidth is free: ~10 Mbps per 1080p
# viewer. Over the Internet use 70-80 - roughly half the bytes, and the
# difference is only visible on text at 100% zoom.
STREAM_QUALITY=100
# Device pixels per CSS pixel for the capture. 2 renders retina-sharp frames at
# four times the pixels (and the bandwidth); 1 is right for almost everyone.
DEVICE_SCALE_FACTOR=1
# Drop frames for a client whose socket has more than this many bytes queued.
BACKPRESSURE_BYTES=262144

# Keep session cookies - the ones a site sets with no expiry - across a browser
# restart. Off by default: such a cookie is the site asking to be forgotten when
# the browser closes, and a desktop browser honours that. But Orbit's browser is
# a shared machine people leave logged in, and `./orbit restart` is an operator
# action rather than a user closing their browser - so with this on, restarting
# no longer signs everyone out of anything where they did not tick "keep me
# signed in". Cookies with a real expiry persist either way, on the profile
# volume, and need none of this. Stored encrypted with a key derived from
# SESSION_SECRET; see docs/security.md.
PERSIST_SESSION_COOKIES=false

# --- Limits ----------------------------------------------------------------
MAX_TABS=20
# Distinct people, not sockets: one person on a laptop and a phone counts once.
MAX_USERS=50
MAX_MESSAGE_RATE=200
MAX_UPLOAD_MB=50

# --- Who may drive which tab ------------------------------------------------
# true: a tab belongs to whoever opened it. They control it, everyone else
# watches and can ask them for control from the toolbar. Recommended - without
# it, anybody can type into the tab you are working in.
TAB_OWNERSHIP=true
# Fallback for tabs with no owner (the browser's own first tab, or tabs created
# before ownership existed). 'view' makes control opt-in even for those.
DEFAULT_TAB_PERMISSION=control

# --- Features --------------------------------------------------------------
CLIPBOARD_ENABLED=true
DOWNLOADS_ENABLED=true
UPLOADS_ENABLED=true
METRICS_ENABLED=true
# Chrome DevTools for admins, proxied through this server's auth. Left OFF here
# on purpose, even though it is genuinely useful and this project develops with
# it on: it is a raw CDP channel to a page, so whoever opens it can run arbitrary
# JavaScript and read that page's cookies - in a shared browser, that means
# whatever accounts the page is signed into. Turn it on deliberately, for a
# trusted set of admins, after reading docs/security.md.
DEVTOOLS_ENABLED=false

# --- LAN discovery (mDNS) --------------------------------------------------
# Advertises http://<MDNS_HOSTNAME>.local on the LAN. IP access always works.
MDNS_ENABLED=true
MDNS_HOSTNAME=shared-browser

# --- Internet mode (optional; see docs/deployment.md) ----------------------
# Comma-separated allowed Origins. Empty = same-origin + LAN private ranges.
TRUSTED_ORIGINS=
# Set true when served over HTTPS through a reverse proxy.
SECURE_COOKIES=false
TRUST_PROXY=false

# --- WebRTC (experimental transport, off by default; see docs/performance.md)
WEBRTC_ENABLED=false
STUN_SERVER=
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# --- Container resource ceilings (docker compose) ---------------------------
# Note: the /tmp tmpfs is RAM-backed and counts against MEMORY_LIMIT. Chromium
# uses several hundred MB of it on image-heavy pages, so leave headroom or the
# renderer gets killed mid-scroll.
# Measured headroom: 20 tabs and 40 viewers peaked at 4.2 GB and saturated six
# cores. 4.0/4g runs fine for a handful of tabs; below that, drop VIEWPORT_* and
# MAX_FPS with it.
CPU_LIMIT=6.0
MEMORY_LIMIT=6g
