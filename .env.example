# ============================================================================
# Orbit configuration. Copy to .env, then change SESSION_SECRET and
# ADMIN_PASSWORD:   cp .env.example .env
#
# These are the values this project runs on: a 6-core / 6 GB box doing 1080p at
# 45fps over a LAN. Tuned for picture quality - free on a LAN, expensive over
# the Internet. The measurements behind them are in docs/performance.md.
# ============================================================================

# --- The working .env, verbatim: copy it, drop the leading "# ", use as is ---
# Only the two secrets are placeholders. Anything left out keeps the default
# from the sections below.
#
# SESSION_SECRET=<openssl rand -hex 32>
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<choose your own>
# LOG_LEVEL=info
# VIEWPORT_WIDTH=1920
# VIEWPORT_HEIGHT=1080
# STREAM_QUALITY=100
# MAX_FPS=45
# MAX_VIEWPORT_WIDTH=2560
# MAX_VIEWPORT_HEIGHT=1440
# PIN_VIEWPORT=true
# MEMORY_LIMIT=6g
# CPU_LIMIT=6.0
# DEVICE_SCALE_FACTOR=1
# HOME_URL=https://www.google.com
# DEVTOOLS_ENABLED=true
# PERSIST_SESSION_COOKIES=true

# --- Server -----------------------------------------------------------------
APP_PORT=3030
SERVER_HOST=0.0.0.0
# 0.0.0.0 = reachable from every interface. Set one IP to limit it to that one.
APP_BIND=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
# Signs session cookies; changing it logs everyone out. openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32
SESSION_TTL_HOURS=168

# --- First admin (created on first start only) ------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Storage (all on the data volume) ---------------------------------------
DATABASE_URL=file:/data/app.db
# Chromium's profile: cookies, localStorage, history.
CHROMIUM_DATA_DIR=/data/profile
DOWNLOAD_DIR=/data/downloads
UPLOAD_DIR=/data/uploads
# One directory per unpacked extension. Changes need a browser restart.
EXTENSIONS_DIR=/data/extensions
EXTENSIONS_ENABLED=true

# --- Chromium ---------------------------------------------------------------
# Where new tabs open. Use about:blank if there is no Internet at all.
HOME_URL=https://www.google.com
CHROMIUM_PATH=
# false = a real headed browser on a virtual display, which is what sites
# expect. Costs ~40% more CPU and twice the memory of headless.
CHROMIUM_HEADLESS=false
# Bound to 127.0.0.1 inside the container and never published (docs/security.md).
CDP_PORT=9222
# Chromium's own sandbox needs SYS_ADMIN in a container (docs/security.md).
CHROMIUM_SANDBOX=false
CHROMIUM_LOCALE=en-US
CHROMIUM_TIMEZONE=UTC

# --- Streaming --------------------------------------------------------------
# The size the page is laid out at. 1280x720 roughly halves CPU and bandwidth.
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080
# true = always stream that size and ignore what each client asks for. Use it
# when your screen is smaller than the resolution you want to browse at.
PIN_VIEWPORT=true
# Ceiling for client-chosen sizes. The virtual screen is sized from these.
MAX_VIEWPORT_WIDTH=2560
MAX_VIEWPORT_HEIGHT=1440
# 45 is smooth for video and scrolling; 30 reads fine and costs a third less CPU.
MAX_FPS=45
# JPEG quality, 1-100. 100 on a LAN (~10 Mbps per viewer); 70-80 over the
# Internet, for about half the bytes.
STREAM_QUALITY=100
# Sharpness: real pixels per CSS pixel. Same layout, drawn more finely. 1 to 3,
# fractions fine. 1 is right for normal monitors. Retina screens look sharper
# at 1.5-2 and cost 1.4-2.6x the bandwidth. Applied at launch, so changing it
# restarts the browser and applies to everyone.
DEVICE_SCALE_FACTOR=1
# Start dropping frames once a client's socket is this many bytes behind.
BACKPRESSURE_BYTES=262144
# Keep cookies that sites set with no expiry across a browser restart, so
# ./orbit restart stops signing everyone out. Encrypted with SESSION_SECRET.
PERSIST_SESSION_COOKIES=false

# --- Limits -----------------------------------------------------------------
MAX_TABS=20
# People, not sockets: one person on a laptop and a phone counts once.
MAX_USERS=50
MAX_MESSAGE_RATE=200
MAX_UPLOAD_MB=50

# --- Who may drive which tab ------------------------------------------------
# true = a tab belongs to whoever opened it; everyone else watches and can ask
# for control. Without it, anyone can type into the tab you are working in.
TAB_OWNERSHIP=true
# For tabs with no owner. 'view' makes control opt-in for those too.
DEFAULT_TAB_PERMISSION=control

# --- Features ---------------------------------------------------------------
CLIPBOARD_ENABLED=true
DOWNLOADS_ENABLED=true
UPLOADS_ENABLED=true
METRICS_ENABLED=true
# DevTools for admins. Off on purpose: it is a raw CDP channel, so whoever opens
# it can run JavaScript and read any page's cookies - in a shared browser that
# means other people's accounts. Read docs/security.md first.
DEVTOOLS_ENABLED=false

# --- LAN discovery ----------------------------------------------------------
# Advertises http://<MDNS_HOSTNAME>.local. Access by IP always works.
MDNS_ENABLED=true
MDNS_HOSTNAME=shared-browser

# --- Internet mode (docs/deployment.md) -------------------------------------
# Allowed Origins, comma-separated. Empty = same-origin plus LAN ranges.
TRUSTED_ORIGINS=
# true when served over HTTPS behind a reverse proxy.
SECURE_COOKIES=false
TRUST_PROXY=false

# --- WebRTC (experimental, off) ---------------------------------------------
WEBRTC_ENABLED=false
STUN_SERVER=
TURN_SERVER=
TURN_USERNAME=
TURN_PASSWORD=

# --- Container ceilings -----------------------------------------------------
# 20 tabs and 40 viewers peaked at 4.2 GB and saturated six cores. /tmp is
# RAM-backed and counts against MEMORY_LIMIT, so leave headroom.
CPU_LIMIT=6.0
MEMORY_LIMIT=6g
